{
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Space Grotesk", "Helvetica Neue", "Arial", "system-ui", "sans-serif"],
        "$description": "Title / Heading / Hero",
        "$extensions": {
          "com.hexadata": {
            "family": "Space Grotesk",
            "role": "Title / Heading / Hero"
          }
        }
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter Tight",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "Noto Sans Devanagari",
          "Nirmala UI",
          "Kohinoor Devanagari",
          "sans-serif"
        ],
        "$description": "Subtitle / Body / Descriptions",
        "$extensions": {
          "com.hexadata": {
            "family": "Inter Tight",
            "role": "Subtitle / Body / Descriptions"
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "Cascadia Mono",
          "Liberation Mono",
          "Consolas",
          "Courier New",
          "monospace"
        ],
        "$description": "Detailed Descriptions / Paragraphs",
        "$extensions": {
          "com.hexadata": {
            "family": "JetBrains Mono",
            "role": "Detailed Descriptions / Paragraphs"
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "$extensions": {
        "com.hexadata": {
          "status": "approved",
          "note": "Not defined by Brand Kit v1.0. Approved by the HexaData Marketing owner on 2026-11-15 (docs/FOUNDATIONS-PROPOSAL.md)."
        }
      },
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "base": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "3xl": {
        "$value": {
          "value": 1.875,
          "unit": "rem"
        }
      },
      "4xl": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "5xl": {
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      },
      "6xl": {
        "$value": {
          "value": 3.75,
          "unit": "rem"
        }
      }
    },
    "lineHeight": {
      "$type": "number",
      "$extensions": {
        "com.hexadata": {
          "status": "approved",
          "note": "Not defined by Brand Kit v1.0. Approved by the HexaData Marketing owner on 2026-11-15 (docs/FOUNDATIONS-PROPOSAL.md)."
        }
      },
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.7
      }
    }
  }
}
