{
  "radius": {
    "$type": "dimension",
    "$extensions": {
      "com.hexadata": {
        "status": "proposed",
        "note": "Not defined by Brand Kit v1.0. Awaiting owner approval; see docs/FOUNDATIONS-PROPOSAL.md."
      }
    },
    "none": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  }
}
