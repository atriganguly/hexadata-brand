{
  "radius": {
    "$type": "dimension",
    "$extensions": {
      "com.hexadata": {
        "status": "approved",
        "note": "Approved foundations for HexaData v2. Precision scale: tags 2 px, controls 4 px, containers 8 px."
      }
    },
    "none": {
      "$value": {
        "value": 0,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.125,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  }
}
