{
  "$description": "Elevation. Shadows are tinted with the palette's midnight. On dark surfaces separate with a grey border, never shadow alone (Brand Kit contrast rule).",
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.midnight}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
