{
  "$description": "Min-width breakpoints. CSS custom properties cannot be used inside @media, so these feed Tailwind/JS/native and the docs.",
  "breakpoint": {
    "$type": "dimension",
    "$extensions": {
      "com.hexadata": {
        "status": "proposed",
        "note": "Not defined by Brand Kit v1.0. Awaiting owner approval; see docs/FOUNDATIONS-PROPOSAL.md."
      }
    },
    "sm": {
      "$value": {
        "value": 40,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 48,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 64,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 80,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 96,
        "unit": "rem"
      }
    }
  }
}
