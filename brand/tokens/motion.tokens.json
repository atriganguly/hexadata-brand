{
  "motion": {
    "duration": {
      "$type": "duration",
      "$extensions": {
        "com.hexadata": {
          "status": "approved",
          "note": "Not defined by Brand Kit v1.0. Approved by the HexaData Marketing owner on 2026-11-15 (docs/FOUNDATIONS-PROPOSAL.md)."
        }
      },
      "instant": {
        "$value": {
          "value": 0,
          "unit": "ms"
        }
      },
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "$extensions": {
        "com.hexadata": {
          "status": "approved",
          "note": "Not defined by Brand Kit v1.0. Approved by the HexaData Marketing owner on 2026-11-15 (docs/FOUNDATIONS-PROPOSAL.md)."
        }
      },
      "standard": {
        "$value": [0.2, 0, 0, 1]
      },
      "enter": {
        "$value": [0, 0, 0, 1]
      },
      "exit": {
        "$value": [0.3, 0, 1, 1]
      }
    }
  }
}
