{
  "name": "@hexadata/brand",
  "version": "2.1.0",
  "description": "HexaData brand system (colour, type, logos, taglines, foundations, components) for web, React, React Native and Tailwind, generated from one source of truth. Self-contained: no third-party requests by default, no browser storage, no personal data.",
  "license": "Apache-2.0 AND LicenseRef-HexaData-Brand",
  "author": "HexaData (Esconet Technologies Limited)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "react",
    "native",
    "elements",
    "tailwind",
    "LICENSE",
    "BRAND-LICENSE.md",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "PRIVACY.md",
    "ACCESSIBILITY.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/types/core/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "dist/types/react/index.d.ts"
      ],
      "native": [
        "dist/types/native/index.d.ts"
      ],
      "tailwind": [
        "dist/tailwind/preset.d.cts"
      ],
      "elements": [
        "dist/types/elements/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/types/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/native/index.d.cts",
        "default": "./dist/native/index.cjs"
      }
    },
    "./elements": {
      "import": {
        "types": "./dist/types/elements/index.d.ts",
        "default": "./dist/elements/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/elements/index.d.cts",
        "default": "./dist/elements/index.cjs"
      }
    },
    "./elements/auto": "./dist/elements/auto.js",
    "./tailwind": {
      "types": "./dist/tailwind/preset.d.cts",
      "default": "./dist/tailwind/preset.cjs"
    },
    "./tailwind/theme.css": "./dist/tailwind/theme.css",
    "./css": "./dist/css/hexadata.css",
    "./base.css": "./dist/css/base.css",
    "./components.css": "./dist/css/components.css",
    "./all.css": "./dist/css/all.css",
    "./fonts.css": "./dist/css/fonts.css",
    "./fonts-fallback.css": "./dist/css/fonts-fallback.css",
    "./logo/*": "./dist/logo/*",
    "./fonts/ttf/*": "./dist/fonts/ttf/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/metrics": "^4.4.0",
    "@capsizecss/unpack": "^4.0.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter-tight": "^5.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/space-grotesk": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.50.0",
    "prettier": "^3.3.0",
    "publint": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "style-dictionary": "^5.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "generate:check": "npm run generate && git diff --exit-code -- src docs/contrast-matrix.md platforms Package.swift figma",
    "build": "npm run generate && node scripts/build.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "test:dist": "node --test test/dist.test.mjs test/channel.dist.test.mjs",
    "verify": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-package.mjs --strict && node scripts/check-types.mjs && publint && attw --pack . --profile node16 --exclude-entrypoints ./tailwind/theme.css ./css ./base.css ./components.css ./all.css ./elements/auto ./fonts.css ./fonts-fallback.css --ignore-rules named-exports",
    "prepublishOnly": "npm run build && npm run build:fonts && npm run build:logos && npm run test && npm run test:dist && npm run test:e2e && npm run verify:release",
    "format": "prettier --write .",
    "check-types": "node scripts/check-types.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "manifest": "node scripts/manifest-tool.mjs",
    "build:logos": "node scripts/build-logos.mjs",
    "logo:check": "node scripts/logo-tool.mjs check",
    "logo:measure": "node scripts/logo-tool.mjs measure",
    "font:check": "node scripts/font-tool.mjs check",
    "font:measure": "node scripts/font-tool.mjs measure",
    "build:channel": "node scripts/build-channel.mjs",
    "build:site": "node site/build.mjs",
    "preview": "node scripts/serve.mjs site-out 4173",
    "build:pdf": "node scripts/build-pdf.mjs",
    "pdf:check": "node scripts/build-pdf.mjs --check",
    "version:check": "node scripts/check-version.mjs",
    "test:site": "node test/site.e2e.mjs",
    "build:platforms": "node scripts/build-platforms.mjs",
    "figma:check": "node scripts/figma-state.mjs check",
    "figma:record": "node scripts/figma-state.mjs record",
    "build:claude-ds": "node scripts/build-claude-ds.mjs",
    "claude-ds:check": "node scripts/claude-ds-state.mjs check",
    "claude-ds:record": "node scripts/claude-ds-state.mjs record"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atriganguly/hexadata-brand.git"
  },
  "bugs": {
    "url": "https://github.com/atriganguly/hexadata-brand/issues"
  },
  "homepage": "https://atriganguly.github.io/hexadata-brand/",
  "keywords": [
    "design-system",
    "design-tokens",
    "brand",
    "branding",
    "hexadata",
    "tailwindcss",
    "react",
    "react-native",
    "css",
    "web-components",
    "wcag",
    "accessibility",
    "dtcg"
  ]
}
